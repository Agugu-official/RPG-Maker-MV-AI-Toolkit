# ── Required ────────────────────────────────────────────────────────────────
# Absolute path to your RPG Maker MV or MZ project root
# Linux/Mac: /home/user/Documents/MyGame
# Windows:   C:\Users\user\Documents\MyGame
RPGMAKER_PROJECT_PATH=/path/to/your/rpgmaker/project

# Optional engine override. "auto" checks the official MV/MZ runtime markers.
# Use mv or mz only for intentionally stripped/custom project fixtures.
RPGMAKER_ENGINE=auto

# ── Optional ────────────────────────────────────────────────────────────────
# Path to the RPG Maker MV or MZ executable (used by the launch-game tool)
# Windows: C:\Program Files\RPG Maker MV\RPGMV.exe
#          C:\Program Files\RPG Maker MZ\RPGMakerMZ.exe
# Mac:     use the executable inside the installed RPG Maker app bundle
RPGMAKER_EXECUTABLE_PATH=/path/to/RPGMaker

# Optional HTTP bridge port (must match the generated debug plugin)
RPGMAKER_BRIDGE_PORT=9001

# Enable verbose debug output (true/false)
MCP_DEBUG=false

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Maximum number of backup files to keep per JSON file (auto-pruned on write)
BACKUP_MAX_COUNT=10
